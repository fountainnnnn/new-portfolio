FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret

# Optional: override the default SQLite database path.
# SQLALCHEMY_DATABASE_URI=sqlite:///application/database.db

# Google OAuth.
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret

# DeepSeek chatbot.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_CHAT_SYSTEM_PROMPT="You are VeggieAI Assistant. Be helpful and concise."

# Internal CNN inference.
MODEL_INFERENCE_URL=http://127.0.0.1:8501

# Session hardening.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_DAYS=7

# Render / reverse proxy.
TRUST_PROXY_HEADERS=false
